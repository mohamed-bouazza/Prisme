# ============================================================
#  Modèle de configuration. Copier ce fichier en ".env" puis adapter les valeurs.
#  Le vrai fichier .env n'est JAMAIS versionné (il contient des secrets).
# ============================================================

# --- PostgreSQL (utilisé par docker-compose.yml et par le backend galerie) ---
POSTGRES_USER=cbir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cbir_gallery
POSTGRES_PORT=5432

# URL de connexion SQLAlchemy construite à partir des valeurs ci-dessus
DATABASE_URL=postgresql+psycopg://cbir:change-me@localhost:5432/cbir_gallery

# --- Backend galerie (Flask) ---
GALLERY_PORT=5000
JWT_SECRET_KEY=change-me-with-a-long-random-string
STORAGE_DIR=./storage
CBIR_API_URL=http://localhost:5001

# --- API CBIR (Flask-RESTful) ---
CBIR_PORT=5001
DATASET_DIR=./data/GHIM-10K
INDEX_DIR=./cbir_api/index

# --- Adminer (interface web pour voir la base) ---
ADMINER_PORT=8080
